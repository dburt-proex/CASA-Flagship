# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Custom Gemini API Key for CASA
gemini-casa-api=""
GEMINI_CASA_API=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Python Governance Engine URL (primary — used by backendBridge)
CASA_GOVERNANCE_API_URL="https://dburt-proex-python-fastapi-backend.onrender.com"

# Aliases for compatibility
PYTHON_API_URL="https://dburt-proex-python-fastapi-backend.onrender.com"
BACKEND_API_URL="https://dburt-proex-python-fastapi-backend.onrender.com"

# Redis Session Storage
REDIS_URL="rediss://default:<password>@<host>:<port>"

# Auth & RBAC
# Secret used to sign and verify JWTs. Use a long random value in production.
JWT_SECRET="your-256-bit-secret"

# Audit Logging
# Google Cloud credentials for @google-cloud/logging (if not using ADC)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/key.json"